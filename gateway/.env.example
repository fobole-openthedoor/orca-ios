# Public origin the desktop uses (must equal ORCA_PUSH_GATEWAY_URL exactly: scheme + host [+ port], no path).
# It is part of the signed handshake transcript, so a mismatch makes every desktop refuse to sign in.
PUBLIC_ORIGIN=https://push.example.com

# Where this process listens (put an HTTPS reverse proxy or tunnel in front).
HOST=127.0.0.1
PORT=8787

# State file (sessions, registrations, badge counts) lives in $DATA_DIR/state.json.
DATA_DIR=./data

# APNs token auth (.p8 from Apple Developer > Keys). Use APNS_KEY_PATH or APNS_KEY (PEM contents, "\n" escapes allowed).
APNS_KEY_PATH=./AuthKey_ABCDE12345.p8
# APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=ABCDE12345
APNS_TEAM_ID=TEAMID1234

# Topic for plain hex tokens, and the only topic a token blob may name unless APNS_ALLOWED_TOPICS is set.
APNS_DEFAULT_TOPIC=com.thm.orcaios
# APNS_ALLOWED_TOPICS=com.thm.orcaios

# Optional: only these desktops (host fingerprints, see the host_signed_in / host_not_allowed log lines) may sign in.
# ALLOWED_HOST_FINGERPRINTS=D20lU_8MD0R64gLt

# Host session lifetime in ms (default 24 h; the desktop renews 60 s before expiry).
# SESSION_TTL_MS=86400000

# Set to 1 behind Caddy / Cloudflare so rate limiting keys on the real client IP.
TRUST_PROXY=1

# debug | info | warn | error
LOG_LEVEL=info

# Testing only: send APNs requests to this origin instead of Apple (h2c when http://).
# APNS_HOST_OVERRIDE=http://127.0.0.1:18443
